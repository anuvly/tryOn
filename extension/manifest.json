{
  "manifest_version": 3,
  "name": "Mirror — Virtual Try-On",
  "version": "0.1.0",
  "description": "Try on products from any shopping site using your personal digital profile.",
  "permissions": ["activeTab", "storage", "scripting", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-scripts/detector.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mirror — Virtual Try-On"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
